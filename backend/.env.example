# Entorno
NODE_ENV=development
PORT=4000

# Base de datos (PostgreSQL en Docker)
DATABASE_URL=postgres://pizza:pizza@localhost:5433/pizzeria

# Secreto para firmar tokens de sesión (admin)
JWT_SECRET=dev-secret-cambiar-en-produccion-123456

# Credenciales iniciales del administrador (opcionales; se crean con `npm run seed`)
# ADMIN_EMAIL=admin@pizzeria.cl
# ADMIN_PASSWORD=admin1234
